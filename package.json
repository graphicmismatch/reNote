{
  "name": "renote",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "A local-first, cross-platform note-taking app with an infinite drawing canvas.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "boundary-lint": "depcruise --config tools/boundary-lint/dependency-cruiser.config.cjs packages apps",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "desktop": "pnpm build && pnpm --filter @renote/electron start",
    "dist:desktop": "pnpm build && pnpm --filter @renote/electron dist",
    "android": "pnpm build && pnpm --filter @renote/desktop exec cap sync android"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "dependency-cruiser": "^16.5.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0"
  }
}
