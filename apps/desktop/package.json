{
  "name": "@renote/desktop",
  "version": "0.0.0",
  "private": true,
  "description": "The reNote app: a React composition root wiring core, canvas-engine, text-editor, ui, storage-client and shortcuts together, shipped as an installable web app (PWA).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "@renote/canvas-engine": "workspace:*",
    "@renote/core": "workspace:*",
    "@renote/shortcuts": "workspace:*",
    "@renote/storage-client": "workspace:*",
    "@renote/text-editor": "workspace:*",
    "@renote/ui": "workspace:*",
    "pixi.js": "^8.6.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^8.6.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
